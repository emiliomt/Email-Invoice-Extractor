# IMAP / Neo.com
# Neo.com uses imap.neo.space on port 993 (TLS)
# If your account has 2FA enabled, generate an App Password in Neo settings
IMAP_HOST=imap.neo.space
IMAP_PORT=993
IMAP_USERNAME=invoices@yourdomain.com
IMAP_PASSWORD=your_app_password

# AWS S3
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
S3_BUCKET_NAME=my-invoice-pdfs
S3_KEY_PREFIX=invoices/

# App behaviour
# FILE_TYPE controls which attachment type is extracted: pdf | xml | both (default: pdf)
FILE_TYPE=pdf
STATE_FILE_PATH=./processed_emails.json
# Uncomment to store state in S3 instead of local disk (required on Render free tier)
# STATE_S3_KEY=state/processed_emails.json
LOG_LEVEL=INFO
